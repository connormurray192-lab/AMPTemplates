Meta.DisplayName=Modded Minecraft
Meta.Description=Minecraft Java server for CurseForge modpacks (Forge/NeoForge/Fabric), installed automatically via itzg's mc-image-helper
Meta.OS=Linux
Meta.AarchSupport=Supported
Meta.Arch=x86_64
Meta.Author=Connor
Meta.URL=https://www.curseforge.com/minecraft/modpacks
Meta.DisplayImageSource=
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=moddedminecraftconfig.json
Meta.MetaConfigManifest=moddedminecraftmetaconfig.json
Meta.ConfigRoot=moddedminecraft.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=4
Meta.ReleaseNotes=Adds full server.properties coverage - 35 more settings across Server, Gameplay, World, Players and Permissions, Performance and Resource Pack, plus an Additional Server Properties box for anything not listed.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=03c5000a-0286-42a3-bd38-556a0fd714d7
Meta.ImportableExtensions=[]
App.DisplayName=Modded Minecraft
App.RootDir=./minecraft/
App.BaseDirectory=./minecraft/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=
App.LinuxCommandLineArgs="{{$FullBaseDir}}start-modded.sh"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} {{InitialMemory}} {{MaxMemory}} {{JavaVersion}} {{AcceptEULA}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=60
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=say {0}
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[moddedminecraftports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=20
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[moddedminecraftupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
App.TemplateMatchRegex={{(\$?[\w]+)}}
App.QuiesceCommand=save-off
App.DequiesceCommand=save-on
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^$
Console.AppReadyRegex=^.+Done \([\d.,]+ ?s?\)!.*$
Console.UserJoinRegex=^.*:\s(?<username>\S+) joined the game$
Console.UserLeaveRegex=^.*:\s(?<username>\S+) left the game$
Console.UserChatRegex=^.*:\s<(?<username>.+?)> (?<message>.+)$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
